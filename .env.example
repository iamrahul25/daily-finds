# Copy this file to .env (or .env.local) and fill in the values (see README.md → "Where to get each environment variable").

# Password for the /admin page
ADMIN_PASSWORD=

# Cloudflare account ID (dashboard → Workers & Pages → Account ID)
CLOUDFLARE_ACCOUNT_ID=

# API token with Account → D1 → Edit and Account → Workers KV Storage → Edit
CLOUDFLARE_API_TOKEN=

# D1 database (product text data)
D1_DATABASE_ID=

# Workers KV namespace (product images)
KV_NAMESPACE_ID=
